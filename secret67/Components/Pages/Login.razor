@page "/Login"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IPasswordHasher<User> Hasher
@inject NavigationManager Nav
<PageTitle>Вход</PageTitle>

<h1>Вход</h1>

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" OnInvalidSubmit="ClearPassword" FormName="login" style="max-width: 320px">
    <DataAnnotationsValidator/>
    <InputText @bind-Value="Input.Username" class="form-control mb-2" placeholder="Логин"/>
    <InputText @bind-Value="Input.Password" type="password" class="form-control mb-2" placeholder="Пароль"/>
    <ValidationSummary/>
    @if (error is not null)
    {
        <div class="text-danger mb-2">@error</div>
    }
    <button type="submit" class="btn btn-primary">Войти</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginModel Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new();
    
    private string? error;

    // Хеш-заглушка: проверяем пароль и для несуществующего логина, чтобы время ответа не выдавало, есть ли такой пользователь
    private static string? dummyHash;

    private async Task LoginAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var username = User.NormalizeUsername(Input.Username);
        var user = await db.Users.FirstOrDefaultAsync(u => u.Username == username);

        dummyHash ??= Hasher.HashPassword(null!, Guid.NewGuid().ToString());
        var result = Hasher.VerifyHashedPassword(user!, user?.PasswordHash ?? dummyHash, Input.Password);

        if (user is null || result == PasswordVerificationResult.Failed)
        {
            error = "Неверный логин или пароль";
            ClearPassword();
            return;
        }

        if (result == PasswordVerificationResult.SuccessRehashNeeded)
        {
            user.PasswordHash = Hasher.HashPassword(user, Input.Password);
            await db.SaveChangesAsync();
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new(ClaimTypes.Name, user.Username)
        };

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(new ClaimsPrincipal(identity));

        Nav.NavigateTo(LocalUrl.OrRoot(ReturnUrl));
    }

    private void ClearPassword() => Input.Password = "";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Введите логин")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }
}