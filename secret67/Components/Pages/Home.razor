@page "/"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>67</PageTitle>

@if (posts is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (posts.Count == 0)
{
    <div class="alert alert-light border text-center" role="alert">
        Пока нет постов
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var post in posts)
        {
            <div class="card shadow-sm" @key="post.Id">
                <div class="card-body">
                    <p class="card-text" style="white-space: pre-line">@post.Text</p>
                </div>
                <div class="card-footer bg-transparent text-body-secondary small">
                    <div class="d-flex justify-content-between">
                        <a href="user/@post.UserId" class="link-secondary">@post.Username</a>
                        <LocalTime Value="post.CreatedAt"/>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {

    private const int PageSize = 50;

    private List<PostView>? posts;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        posts = await db.Posts
            .OrderByDescending(p => p.CreatedAt)
            .Take(PageSize)
            .Select(p => new PostView(p.Id, p.Text, p.CreatedAt, p.UserId, p.User.Username))
            .ToListAsync();
    }

    private sealed record PostView(int Id, string Text, DateTime CreatedAt, int UserId, string Username);

}
