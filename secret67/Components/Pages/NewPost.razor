@page "/NewPost"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject ILogger<NewPost> Logger

<PageTitle>Новый пост</PageTitle>

<EditForm Model="Input" method="post" OnValidSubmit="NewPostAsync" FormName="newpost" style="max-width: 320px">
    <DataAnnotationsValidator/>
    <InputTextArea @bind-Value="Input.Text" class="form-control mb-2" placeholder="Текст"/>
    <ValidationSummary/>
    @if (error is not null)
    {
        <div class="text-danger mb-2">@error</div>
    }
    <button type="submit" class="btn btn-primary">Отправить</button>
</EditForm>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;
    [SupplyParameterFromForm] private NewPostModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private string? error;

    private async Task NewPostAsync()
    {
        var userClaims = (await AuthState).User;
        await using var db = await DbFactory.CreateDbContextAsync();
        var newPost = new Post { Text = Input.Text.Trim(), UserId = int.Parse(userClaims.FindFirst(ClaimTypes.NameIdentifier)!.Value) };
        db.Posts.Add(newPost);
        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Не удалось сохранить пост пользователя {UserId}", newPost.UserId);
            error = "Не удалось сохранить пост, попробуйте ещё раз";
            return;
        }

        Nav.NavigateTo("/user");
    }

    public sealed class NewPostModel
    {
        [Required(ErrorMessage = "Введите текст поста")]
        [MaxLength(2000, ErrorMessage = "Не больше 2000 символов")]
        public string Text  { get; set; } = "";
    }
}