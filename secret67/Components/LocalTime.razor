<time datetime="@Value.ToString("O")">@Formatted</time>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter, EditorRequired] public DateTime Value { get; set; }
    [Parameter] public string Format { get; set; } = "dd.MM.yyyy HH:mm";

    private string Formatted
    {
        get
        {
            // Часовой пояс браузера, записанный скриптом из App.razor
            var tz = TimeZoneInfo.Utc;
            var tzId = HttpContext?.Request.Cookies["tz"];
            if (tzId is not null && TimeZoneInfo.TryFindSystemTimeZoneById(tzId, out var found))
                tz = found;
            return TimeZoneInfo.ConvertTimeFromUtc(Value, tz).ToString(Format);
        }
    }
}
