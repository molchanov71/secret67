@inject NavigationManager Nav

<nav class="navbar navbar-expand-md bg-dark px-3" data-bs-theme="dark">
    <a class="navbar-brand" href="">67</a>
    
    <input type="checkbox" id="nav-toggle" class="nav-toggle"/>
    <label for="nav-toggle" class="navbar-toggler" title="Меню">
        <span class="navbar-toggler-icon"></span>
    </label>
    
    <div class="nav-links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Главная</NavLink>
    </div>
    <div class="nav-links ms-md-auto">
        <AuthorizeView>
            <Authorized>
                @if (!IsOnOwnPage)
                {
                    <NavLink class="nav-link" href="/user">Посты</NavLink>
                }
                <form method="post" action="/logout">
                    <AntiforgeryToken/>
                    <button type="submit" class="btn btn-link nav-link">Выйти (@context.User.Identity?.Name)</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link" href="login">Войти</NavLink>
                <NavLink class="nav-link" href="register">Зарегистрироваться</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private bool IsOnOwnPage =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/')
            .Equals("user", StringComparison.OrdinalIgnoreCase);

}